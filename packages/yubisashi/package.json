{
  "name": "@hyuga/yubisashi",
  "version": "0.1.0",
  "description": "Point before you write. Before a call that changes the world, runs the completion contract's probe once — so a probe that cannot run, a target that is not there, or an expectation that is already true is found while the fix is cheap. The same line groundtruth re-checks at the end.",
  "type": "module",
  "main": "src/yubisashi.mjs",
  "exports": {
    ".": "./src/yubisashi.mjs"
  },
  "bin": {
    "yubisashi": "src/yubisashi.mjs"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "claude-code",
    "hooks",
    "ai",
    "agent",
    "coding-agent",
    "guardrails",
    "verification",
    "pointing-and-calling",
    "developer-tools"
  ],
  "dependencies": {
    "@hyuga/groundtruth": "^0.5.3",
    "@hyuga/redline": "^0.6.0",
    "@hyuga/spar": "^0.3.0"
  },
  "publishConfig": {
