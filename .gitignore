node_modules/
dist/
*.log
.DS_Store

# Local configuration: it names your tables and may point at a real database.
# The pattern is deliberately unanchored, so it catches one in any directory —
# which also catches the worked examples, hence the exemption. Those hold no
# host, no table of yours and no secret, only environment references.
llm-safe-sql.config.json
!examples/**/llm-safe-sql.config.json
*.local.json

# Build artefacts from `npm pack`, which is run by hand while testing an install.
*.tgz
.spar/
.t/
.groundtruth/
